{
  "name": "agent-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "art": "esbuild scripts/gen-art.ts --bundle --platform=node --format=esm --outfile=scripts/.gen-art.mjs --log-level=warning && node scripts/.gen-art.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "description": "A team of AI agents (Claude Code, Codex, Gemini, OpenRouter) working on your code, in a pixel-art arena",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielmoreiraf/agent-arena.git"
  }
}
