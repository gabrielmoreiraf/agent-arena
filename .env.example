# Copie para .env.local e preencha só o que for usar.
# Estas variáveis são lidas apenas pelo servidor local (Vite), nunca vão para o navegador.

# --- Integrações de tarefas ---
CLICKUP_TOKEN=
CLICKUP_LIST_ID=

JIRA_BASE_URL=https://sua-empresa.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# opcional
JIRA_JQL=assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC

LINEAR_API_KEY=

GITHUB_TOKEN=
GITHUB_REPO=dono/repositorio

# --- Contas de IA (só a presença é verificada por enquanto) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Execução real (Claude Code headless) ---
# Repositório onde os agentes trabalham de verdade (também dá para trocar na tela "Execução real")
ARENA_TARGET_DIR=
# Caminho do binário, se o `claude` não estiver no PATH do servidor
CLAUDE_BIN=
